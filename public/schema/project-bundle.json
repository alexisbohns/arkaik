{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkaik.app/schema/project-bundle.json",
  "version": 2,
  "title": "Arkaik ProjectBundle",
  "description": "The import/export format for an Arkaik product graph. Contains a project, its nodes (flows, views, data models, API endpoints), and edges (relationships between nodes).",
  "type": "object",
  "required": [
    "project",
    "nodes",
    "edges"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "description": "Bundle Format contract version. Absent means 1 (docs/spec/bundle-format.md § Schema Versioning). Older versions migrate through an explicit chain; unknown fields from newer versions are preserved on re-export.",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "description": "All nodes in the project graph."
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "description": "All edges (relationships) between nodes."
    },
    "journal": {
      "description": "Optional embedded journal events — the Level 2 interchange projection (docs/spec/journal.md). Canonical storage in repos is the JSONL sidecar; a bundle without a journal is Level 0/1, not an error.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/JournalEvent"
      }
    },
    "quality": {
      "description": "Optional Kritik quality state (docs/rfcs/kritik.md § 4.1) — the pinned pack version, the project's surface profile, its assessments and findings. Additive: a bundle without it is not an error, and the comparative matrix is derived from it (deriveQualityMatrix), never stored.",
      "$ref": "#/$defs/QualitySection"
    }
  },
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier."
        },
        "title": {
          "type": "string",
          "description": "Project title."
        },
        "description": {
          "description": "Optional project description.",
          "type": "string"
        },
        "version": {
          "description": "Current version label of the mapped product (free-form; semver recommended, not required). Version history lives in the journal as release.tagged events.",
          "type": "string"
        },
        "root_node_id": {
          "description": "ID of the root node used as the canvas entry point. Should reference an existing node.",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ProjectMetadata"
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601 creation timestamp."
        },
        "updated_at": {
          "type": "string",
          "description": "ISO 8601 last-update timestamp."
        },
        "archived_at": {
          "description": "ISO 8601 archive timestamp, or null if active.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "ProjectMetadata": {
      "type": "object",
      "properties": {
        "view_card_variant": {
          "type": "string",
          "enum": [
            "compact",
            "large"
          ]
        },
        "maps": {
          "description": "Stored map definitions (docs/spec/maps.md § Storage) — additive; unknown fields preserved.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapDefinition"
          }
        },
        "map_display": {
          "description": "Per-map display overrides keyed by map id (docs/spec/maps.md § Display Options) — the only path open to the built-in maps.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/MapDisplayOptions"
          }
        },
        "products": {
          "description": "Product definitions (docs/spec/bundle-format.md § Products) — additive; unknown fields preserved.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductDefinition"
          }
        },
        "pollen": {
          "description": "Federation settings — docs/spec/services.md § Pollen feed. `plant` enables the feed.",
          "type": "object",
          "properties": {
            "plant": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {},
      "description": "Optional project-level UI settings."
    },
    "MapDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kebab-case, unique within the project; built-in ids (journey, system) are reserved."
        },
        "title": {
          "type": "string",
          "description": "Display title."
        },
        "description": {
          "description": "What this map is for.",
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Map kind: journey | system. Selects the renderer and selection defaults; unrecognized kinds are preserved and listed as unrenderable."
        },
        "species": {
          "description": "Node filter; defaults by kind (journey: flow+view; system: view+api-endpoint+data-model).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edge_types": {
          "description": "Edge filter; defaults by kind (journey: composes; system: calls+displays+queries).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root_node_id": {
          "description": "Scope anchor: the subgraph is the undirected neighborhood reachable from this node.",
          "type": "string"
        },
        "product": {
          "description": "Product scope; absent = every product.",
          "type": "string"
        },
        "depth": {
          "description": "Traversal bound from the root; absent = unbounded.",
          "type": "number"
        },
        "layout": {
          "description": "Renderer layout hints (e.g. direction: DOWN | RIGHT).",
          "type": "object",
          "properties": {
            "direction": {
              "type": "string"
            }
          },
          "additionalProperties": {}
        },
        "display": {
          "description": "Card rendering; the human twin is project.metadata.map_display[id].",
          "$ref": "#/$defs/MapDisplayOptions"
        }
      },
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": {},
      "description": "A stored map definition (docs/spec/maps.md § MapDefinition)."
    },
    "MapDisplayOptions": {
      "type": "object",
      "properties": {
        "images": {
          "description": "Screenshot (or cover) art on view cards.",
          "type": "boolean"
        },
        "flow_platforms": {
          "description": "A flow card's platform delivery: rings (default) | bars.",
          "type": "string"
        },
        "view_platforms": {
          "description": "A view card's platform availability: chips (default) | rows.",
          "type": "string"
        },
        "minimap_color": {
          "description": "What a minimap node's fill encodes: status (default) | species.",
          "type": "string"
        }
      },
      "additionalProperties": {},
      "description": "How a map draws its cards (docs/spec/maps.md § Display Options)."
    },
    "ProductDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kebab-case, unique within the project."
        },
        "title": {
          "type": "string",
          "description": "Display title."
        },
        "description": {
          "description": "What this product is.",
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Platform"
          },
          "description": "The platforms this product can ship on; empty means availability is not tracked."
        },
        "root_node_id": {
          "description": "This product's journey anchor.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "platforms"
      ],
      "additionalProperties": {},
      "description": "A product definition (docs/spec/bundle-format.md § Products)."
    },
    "Platform": {
      "type": "string",
      "enum": [
        "web",
        "ios",
        "android"
      ],
      "description": "Target platform."
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node ID. Convention: prefix with species — F- (flow), V- (view), DM- (data-model), API- (api-endpoint)."
        },
        "project_id": {
          "type": "string",
          "description": "Must match project.id."
        },
        "species": {
          "$ref": "#/$defs/Species"
        },
        "title": {
          "type": "string",
          "description": "Human-readable node title."
        },
        "description": {
          "description": "Optional description of the node's purpose.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnyStatus"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Platform"
          },
          "description": "One or more target platforms."
        },
        "metadata": {
          "$ref": "#/$defs/NodeMetadata"
        }
      },
      "required": [
        "id",
        "project_id",
        "species",
        "title",
        "status",
        "platforms"
      ],
      "additionalProperties": false
    },
    "Species": {
      "type": "string",
      "enum": [
        "flow",
        "view",
        "data-model",
        "api-endpoint",
        "acceptance",
        "decision"
      ],
      "description": "The species of a node. flow = ordered sequence of views/sub-flows. view = reusable page or screen. data-model = data entity/table. api-endpoint = API endpoint. acceptance = a testable promise (one Given/When/Then) with per-platform status."
    },
    "AnyStatus": {
      "type": "string",
      "enum": [
        "idea",
        "discovery",
        "backlog",
        "development",
        "releasing",
        "live",
        "archived",
        "prioritized",
        "blocked"
      ],
      "description": "Lifecycle status as stored: the current vocabulary, or a legacy id (prioritized, blocked) accepted from pre-v3 bundles and migrated on load."
    },
    "NodeMetadata": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string"
        },
        "blocked_by": {
          "description": "Non-empty = blocked at the current status. A node id (rendered as a link) or free text naming the dependency.",
          "type": "string"
        },
        "playlist": {
          "$ref": "#/$defs/FlowPlaylist"
        },
        "platformNotes": {
          "$ref": "#/$defs/PlatformNotesMap"
        },
        "platformStatuses": {
          "$ref": "#/$defs/PlatformStatusMap"
        },
        "platformScreenshots": {
          "$ref": "#/$defs/PlatformScreenshotsMap"
        },
        "refs": {
          "description": "Typed external references on the node.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        },
        "gherkin": {
          "description": "Acceptance nodes only: exactly one Given/When/Then scenario (the How). A second scenario is a second acceptance node.",
          "type": "string"
        },
        "values": {
          "description": "Acceptance nodes only: 1..n Bain value elements served (the Why).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          }
        },
        "product": {
          "description": "Product membership (docs/spec/bundle-format.md § Products); flow, view, and acceptance only.",
          "type": "string"
        },
        "decision_status": {
          "description": "Decision nodes only: proposed | approved | enacted | rejected | deprecated | superseded. The node's lifecycle status is kept in sync (spec §2).",
          "$ref": "#/$defs/DecisionStatus"
        },
        "context": {
          "description": "Decision nodes only: Context — the Why (markdown).",
          "type": "string"
        },
        "consequences": {
          "description": "Decision nodes only: Consequences — the How (markdown).",
          "type": "string"
        },
        "decided_at": {
          "description": "Decision nodes only: ISO 8601 date the decision was made.",
          "type": "string"
        }
      },
      "additionalProperties": {},
      "description": "Optional metadata for a node."
    },
    "FlowPlaylist": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaylistEntry"
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "PlaylistEntry": {
      "description": "An entry in a flow's playlist. Discriminated union on 'type'.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "view"
            },
            "view_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "view_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "flow"
            },
            "flow_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "flow_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "condition"
            },
            "label": {
              "type": "string"
            },
            "if_true": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlaylistEntry"
              }
            },
            "if_false": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlaylistEntry"
              }
            }
          },
          "required": [
            "type",
            "label",
            "if_true",
            "if_false"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "junction"
            },
            "label": {
              "type": "string"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JunctionCase"
              }
            }
          },
          "required": [
            "type",
            "label",
            "cases"
          ],
          "additionalProperties": false
        }
      ]
    },
    "JunctionCase": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaylistEntry"
          }
        }
      },
      "required": [
        "label",
        "entries"
      ],
      "additionalProperties": false
    },
    "PlatformNotesMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Platform"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Freeform per-platform notes."
    },
    "PlatformStatusMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Platform"
      },
      "additionalProperties": {
        "$ref": "#/$defs/AnyStatus"
      },
      "description": "Per-platform status overrides for view nodes."
    },
    "PlatformScreenshotsMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Platform"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Per-platform screenshot: a relative path, an absolute URL, or a data URI (see docs/spec/bundle-format.md § Asset Values)."
    },
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the node, kebab-case (e.g. \"gh-142\")."
        },
        "type": {
          "type": "string",
          "description": "Ref type: figma | github-issue | gitlab-issue | linear-issue | github-pr | gitlab-mr | url. Unrecognized values are preserved and render as generic links."
        },
        "url": {
          "type": "string",
          "description": "Canonical external URL."
        },
        "title": {
          "description": "Display label.",
          "type": "string"
        },
        "external_status": {
          "description": "Mirrored external state, verbatim (e.g. \"open\", \"merged\", \"In Progress\").",
          "type": "string"
        },
        "status_mapped": {
          "description": "Optional mapping of external_status into the arkaik lifecycle. Advisory display data — never mutates node.status.",
          "$ref": "#/$defs/AnyStatus"
        },
        "platform": {
          "description": "Optional scoping to one platform variant.",
          "$ref": "#/$defs/Platform"
        },
        "synced_at": {
          "description": "ISO 8601 — when external_status was last mirrored.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "url"
      ],
      "additionalProperties": false,
      "description": "A typed external reference on a node (docs/spec/bundle-format.md § References)."
    },
    "Value": {
      "type": "string",
      "enum": [
        "saves-time",
        "simplifies",
        "makes-money",
        "reduces-risk",
        "organizes",
        "integrates",
        "connects",
        "reduces-effort",
        "avoids-hassles",
        "reduces-cost",
        "quality",
        "variety",
        "sensory-appeal",
        "informs",
        "reduces-anxiety",
        "rewards-me",
        "nostalgia",
        "design-aesthetics",
        "badge-value",
        "wellness",
        "therapeutic-value",
        "fun-entertainment",
        "attractiveness",
        "provides-access",
        "provides-hope",
        "self-actualization",
        "motivation",
        "heirloom",
        "affiliation-belonging",
        "self-transcendence"
      ],
      "description": "A Bain B2C Elements-of-Value element served by an acceptance (spec §3.2)."
    },
    "DecisionStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "enacted",
        "rejected",
        "deprecated",
        "superseded"
      ],
      "description": "Decision nodes only: proposed → approved (agreed, not yet reality) → enacted (in effect); terminal: rejected, deprecated, superseded. Not a lifecycle status — the node's status field is kept in sync (proposed→discovery, approved→backlog, enacted→live, terminals→archived)."
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique edge ID. Convention: e-{source_id}-{target_id}."
        },
        "project_id": {
          "type": "string",
          "description": "Must match project.id."
        },
        "source_id": {
          "type": "string",
          "description": "ID of the source node."
        },
        "target_id": {
          "type": "string",
          "description": "ID of the target node."
        },
        "edge_type": {
          "$ref": "#/$defs/EdgeType"
        },
        "metadata": {
          "description": "Optional edge metadata.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "project_id",
        "source_id",
        "target_id",
        "edge_type"
      ],
      "additionalProperties": false
    },
    "EdgeType": {
      "type": "string",
      "enum": [
        "composes",
        "calls",
        "displays",
        "queries",
        "covers",
        "supersedes",
        "generates",
        "impacts"
      ],
      "description": "composes = structural hierarchy (flow↔view). calls = view/flow → api-endpoint, or api-endpoint → api-endpoint (endpoint fan-out to internal/external APIs). displays = view → data-model. queries = api-endpoint → data-model. covers = acceptance → view/flow (which surface the acceptance is proven on)."
    },
    "JournalEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ULID — sortable, collision-free without coordination."
        },
        "ts": {
          "type": "string",
          "description": "ISO 8601 timestamp."
        },
        "actor": {
          "description": "Who/what wrote it (e.g. \"claude-code\", \"ci\").",
          "type": "string"
        },
        "v": {
          "description": "Reserved per-event payload version; absent today.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "description": "Event type — the v1 vocabulary in docs/spec/journal.md, or an unknown forward-compatible value."
        }
      },
      "required": [
        "id",
        "ts",
        "type"
      ],
      "additionalProperties": true,
      "description": "One append-only journal event. Type-specific payload fields sit flat on the object; unknown types and fields are preserved on rewrite (forward compatibility). See docs/spec/journal.md."
    },
    "QualitySection": {
      "type": "object",
      "properties": {
        "framework_version": {
          "type": "string"
        },
        "library": {
          "$ref": "#/$defs/KritikLibrary"
        },
        "profile": {
          "$ref": "#/$defs/QualityProfile"
        },
        "assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityAssessment"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFinding"
          }
        }
      },
      "required": [
        "framework_version",
        "profile",
        "assessments",
        "findings"
      ],
      "additionalProperties": {},
      "description": "The project's Kritik state (docs/rfcs/kritik.md § 4.1) — profile, assessments, findings. Criteria are library content, not graph nodes; the matrix is a projection, never stored."
    },
    "KritikLibrary": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "Semver of the pack; matrices are comparable only within a major."
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KritikDomain"
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KritikCriterion"
          }
        },
        "scales": {
          "$ref": "#/$defs/KritikScales"
        }
      },
      "required": [
        "version",
        "domains",
        "criteria"
      ],
      "additionalProperties": {},
      "description": "A versioned criteria pack. Embedded on export; repos may instead pin it as a sidecar file."
    },
    "KritikDomain": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": {},
      "description": "A top-level criteria category owning a roll-up row in the matrix."
    },
    "KritikCriterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier, `<DOMAIN>-NN`. Never redefined — retired via superseded_by."
        },
        "domain": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "applies_to": {
          "description": "Surface ids where the criterion is meaningful; absence means N/A.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level_anchors": {
          "description": "Observable descriptions per maturity level, keyed l0…l4.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "default_impact": {
          "type": "number"
        },
        "weight": {
          "description": "Weight in the domain roll-up (1–3; 3 = load-bearing). Absent means 1.",
          "type": "number"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KritikReference"
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signals": {
          "description": "Mechanically checkable monitoring hooks run between audits.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediation": {
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/KritikIssueTemplate"
        },
        "superseded_by": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain"
      ],
      "additionalProperties": {},
      "description": "The atomic auditable unit (packages/kritik-library/SPEC.md § 5)."
    },
    "KritikReference": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": {},
      "description": "A stable external anchor behind a criterion (OWASP control, GDPR article, WCAG SC…)."
    },
    "KritikIssueTemplate": {
      "type": "object",
      "properties": {
        "title_template": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body_skeleton": {
          "type": "string"
        }
      },
      "additionalProperties": {},
      "description": "Per-criterion issue skeleton — what `arkaik kritik issue` prefills."
    },
    "KritikScales": {
      "type": "object",
      "properties": {
        "grades": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "severity_buckets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "caps": {
          "type": "object",
          "properties": {
            "critical_open": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            },
            "high_open": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {},
      "description": "Overridable maturity/severity/grade scales carried by a criteria pack. Absent entries fall back to the framework defaults (packages/kritik-library/SPEC.md § 4)."
    },
    "QualityProfile": {
      "type": "object",
      "properties": {
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurfaceDef"
          }
        },
        "domain_weights": {
          "description": "Per-domain weight in the surface roll-up, keyed by domain code. A missing weight is 1.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "surfaces"
      ],
      "additionalProperties": {},
      "description": "The project's parameterization of the pack (RFC § 6)."
    },
    "SurfaceDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "platform": {
          "description": "Optional bridge to PLATFORM_IDS where a surface is also a view-shipping platform. Surfaces are not platforms (RFC § 2).",
          "$ref": "#/$defs/Platform"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": {},
      "description": "One independently assessable body of code — an audit target, chosen at install."
    },
    "QualityAssessment": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 4
            }
          ],
          "description": "Maturity 0–4. N/A is the absence of the row, never a level."
        },
        "evidence": {
          "type": "string",
          "description": "file:line / config citations. A score without evidence is an opinion, not an assessment."
        },
        "audit_id": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "surface",
        "level",
        "evidence",
        "audit_id",
        "ts"
      ],
      "additionalProperties": {},
      "description": "One (criterion × surface) score — latest wins; history lives in the journal."
    },
    "QualityFinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "criterion_id": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "impact": {
          "type": "number",
          "description": "Worst plausible consequence, 1–5."
        },
        "likelihood": {
          "type": "number",
          "description": "Probability it materializes, 1–5."
        },
        "cost": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "refuted",
            "accepted-risk"
          ]
        },
        "remediation": {
          "type": "string"
        },
        "node_ids": {
          "description": "Graph nodes this finding is about — the tie deliverable.shipped already uses.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issue_url": {
          "type": "string"
        },
        "verification": {
          "description": "Result of the adversarial refutation pass. Refuted findings are disclosed, not deleted.",
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "REFUTED",
                "DOWNGRADED"
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "criterion_id",
        "surface",
        "title",
        "detail",
        "evidence",
        "impact",
        "likelihood",
        "cost",
        "status"
      ],
      "additionalProperties": {},
      "description": "One concrete defect. Severity and priority are deliberately absent — they are derived from impact × likelihood and cost (deriveQualityMatrix), so a finding can never carry a severity its own numbers disagree with."
    }
  }
}
