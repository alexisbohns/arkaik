# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# transient CJS build emitted by the schema parity test / contract generators
/packages/schema/.test-build/
/packages/schema/.generate-build/
/tests/data/.test-build/
/tests/data/.test-build-export/
/tests/data/.test-build-journal/
/tests/data/.test-build-emit-events/
/tests/data/.test-build-local-provider/
/tests/data/.test-build-provider-registry/
/tests/data/.test-build-project-sections/
/tests/services/.test-build-publik/
/tests/services/.test-build-graph/
/tests/services/.test-build-github/
/tests/services/.test-build-pr-plan/
/tests/services/.test-build-github-app/
/tests/services/.test-build-graph-restore/
/tests/app/.test-build-delivery/
/tests/app/.test-build-journey-graph/
/tests/app/.test-build-graph-spotlight/
/tests/app/.test-build-coverage/
/tests/app/.test-build-panels-*/
/tests/app/.test-build-product-*/
/packages/cli/.test-build/
# transient CJS build emitted by the bootstrap-lib direct-require tests
# (tests/cli/load-bootstrap-lib.js) — a separate dir from the one above,
# which holds unrelated esbuild-bundled ESM mocks for a different suite
/packages/cli/.test-build-bootstrap/

# next.js
/.next/
/out/

# production
/build

# esbuild-bundled CLI output (rebuilt on demand by `npm run build -w arkaik`)
/packages/cli/dist/
/packages/mcp/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorm sessions
/.superpowers/

# git worktrees for isolated feature work
/.worktrees/
