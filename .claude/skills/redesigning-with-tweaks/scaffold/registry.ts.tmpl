/**
 * TWEAKER SCAFFOLD (redesigning-with-tweaks skill) — merges every author's
 * variants. Authors edit ONLY their own folder; ADAPT the imports to the
 * AUTHORS list in `contract.ts` once, then this file never needs touching.
 */
import type { SectionId, TweakPreset, TweakVariant, VariantRegistry } from "./contract";
import { variants as bold, presets as boldPresets } from "./bold";
import { variants as calm, presets as calmPresets } from "./calm";
import { variants as lead, presets as leadPresets } from "./lead";
import { registerPresets } from "./store";

const REGISTRIES: VariantRegistry[] = [lead, bold, calm];

export function variantsFor<S extends SectionId>(section: S): TweakVariant<S>[] {
  return REGISTRIES.flatMap((r) => (r[section] ?? []) as TweakVariant<S>[]);
}

export function findVariant<S extends SectionId>(section: S, id: string): TweakVariant<S> | undefined {
  return variantsFor(section).find((v) => v.id === id);
}

export const PRESETS: TweakPreset[] = [...leadPresets, ...boldPresets, ...calmPresets];

// So a recipe can say `preset:<id>` (the store must not import this file: cycle).
registerPresets(PRESETS);

export type { VariantRegistry };
