"use client";

/**
 * TWEAKER SCAFFOLD (redesigning-with-tweaks skill) — renders the picked variant of a section, or the shipped
 * UI (`children`) when the pick is "base", unknown, or CSS-only. Registers the
 * section as mounted so the tweaker can list what is on screen first.
 */
import { useEffect, type ReactNode } from "react";
import type { SectionId, SectionProps } from "./contract";
import { findVariant } from "./registry";
import { markMounted, usePick } from "./store";

type Props<S extends SectionId> = {
  section: S;
  props: Omit<SectionProps[S], "renderOriginal">;
  children: ReactNode;
};

export function TweakSlot<S extends SectionId>({ section, props, children }: Props<S>) {
  useEffect(() => markMounted(section), [section]);
  const id = usePick(section);
  const variant = id === "base" ? undefined : findVariant(section, id);
  const Component = variant?.Component;
  if (!Component) return <>{children}</>;
  const full = { ...props, renderOriginal: () => children } as SectionProps[S];
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  return <Component {...(full as any)} />;
}

/** For a CSS-only section that has no wrapping JSX of its own: just registers it. */
export function TweakMark({ section }: { section: SectionId }) {
  useEffect(() => markMounted(section), [section]);
  return null;
}
